<Window x:Class="App1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="280"
        Height="400" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

    <Grid Background="Gray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
                
        <TextBox  Margin="10, 0" Grid.Row="0"
        Grid.Column="0"
        Grid.ColumnSpan="3" Height="50"/>
        <Button Grid.Column="3" Width="50" Height="50" Content="C"
        Background="Red"/>

        <StackPanel Margin="15, 0" Spacing="15px" Grid.ColumnSpan="4" Grid.Row="1" Orientation="Horizontal">
               <Button Width="50" Height="50" Content="1"
        Background="Red"/>
           <Button Width="50" Height="50" Content="2"
        Background="Red"/>
           <Button  Width="50" Height="50" Content="3"
        Background="Red"/>
                      <Button Width="50" Height="50" Content="+"
        Background="Red"/>
        </StackPanel>

         <StackPanel Margin="15, 0" Spacing="15px" Grid.ColumnSpan="4" Grid.Row="2" Orientation="Horizontal">
               <Button Width="50" Height="50" Content="4"
        Background="Red"/>
           <Button Width="50" Height="50" Content="5"
        Background="Red"/>
           <Button  Width="50" Height="50" Content="6"
        Background="Red"/>
                   <Button Width="50" Height="50" Content="-"
        Background="Red"/>
        </StackPanel>


         <StackPanel Margin="15, 0" Spacing="15px" Grid.ColumnSpan="4" Grid.Row="3" Orientation="Horizontal">
               <Button Width="50" Height="50" Content="7"
        Background="Red"/>
           <Button Width="50" Height="50" Content="8"
        Background="Red"/>
           <Button  Width="50" Height="50" Content="9"
        Background="Red"/>

                <Button  Width="50" Height="50" Content="/"
        Background="Red"/>

        </StackPanel>


         <StackPanel Margin="15, 0" Spacing="15px" Grid.ColumnSpan="4" Grid.Row="4" Orientation="Horizontal" >
               <Button Width="50" Height="50" Content=","
        Background="Red"/>
           <Button Width="50" Height="50" Content="0"
        Background="Red"/>
           <Button  Width="50" Height="50" Content="*"
        Background="Red"/>
        <Button  Width="50" Height="50" Content="="
        Background="Red"/>
        </StackPanel>
     </Grid>
</Window>
