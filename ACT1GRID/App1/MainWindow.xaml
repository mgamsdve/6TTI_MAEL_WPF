<Window x:Class="App1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600"
        Height="450" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
        Background="Yellow"
        Grid.Row="0"
        Grid.Column="0">

        <Button Content="Bouton 1" Height="100"/>
        <Button Content="Bouton 2" Height="100" />
        </StackPanel>

        <DockPanel 
        Grid.Column="1"
        Grid.Row="0"
        >
            <Button DockPanel.Dock="Top" Height="50">Top</Button>
            <Button DockPanel.Dock="Bottom" Height="50">Bottom</Button>
            <Button DockPanel.Dock="Left" Width="50">Left</Button>
            <Button DockPanel.Dock="Right" Width="50">Right</Button>
            <Button>Center</Button>
        </DockPanel>

        <WrapPanel
        Grid.Column="0"
        Grid.Row="1"
        Width="240"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="Green">
            <Button Width="80" Content="Bouton 1" />
            <Button Width="80" Content="Bouton 2"/>
            <Button Width="80" Content="Bouton 3"/>
            <Button Width="80" Height="80" Content="Bouton 4"/>
            <Button Width="80" Content="Bouton 5"/>
            <Button Width="80" Content="Bouton 6"/>
        </WrapPanel>

        <Canvas Grid.Column="1" Grid.Row="1" >
            <Ellipse
            Width="150"
            Height="150"
            Fill="Black"
            Canvas.Left="70"
            Canvas.Top="40" />
            <Ellipse
            Width="100"
            Height="100"
            Fill="Yellow"
            Canvas.Left="95"
            Canvas.Top="65" />
            <Ellipse
            Width="50"
            Height="50"
            Fill="Red"
            Canvas.Left="120"
            Canvas.Top="90" />
        </Canvas>
    </Grid>
</Window>
